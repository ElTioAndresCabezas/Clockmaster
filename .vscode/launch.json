{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Clockmaster (Debug - GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/clockmaster",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Habilitar pretty-printing para GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build (Debug)"
        },
        {
            "name": "Clockmaster (Debug - CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/clockmaster",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cmake: build (Debug)"
        },
        {
            "name": "Clockmaster (Ejecutar Release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux/clockmaster",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "cmake: build (Release)"
        }
    ]
}
