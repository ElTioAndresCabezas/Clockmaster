export global Theme {
    // Fondos y superficies
    in-out property <color> background: #1d1d1d;
    in-out property <color> surface: #181818;
    in-out property <color> border: #323232;

    // Tipografía
    in-out property <color> text: #cdd6f4;
    in-out property <color> text-subtle: #bac2de;
    in-out property <color> text-muted: #a6adc8;

    // Estados y acentos
    in-out property <color> active: #a6e3a1;
    in-out property <color> inactive: #6c6c6c;
}
